# DEV ONLY: these optional settings do not make TestLab production-ready.
# See docs/production-readiness.md for missing production implementation and setup.
# Without these, the app runs entirely in local learning mode.
# Use your own PostgreSQL database. Do not commit real credentials.
DATABASE_URL=
# Start runner/service.mjs separately; see README. Never expose the Docker socket.
RUNNER_URL=
RUNNER_TOKEN=
# Standalone runner process only; it does not read Next.js .env.local automatically.
# Export RUNNER_PORT in that process if you need a port other than its default 4001.

{
  "name": "learn-how-to-write-tests",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/setup-monaco.mjs && next dev",
    "build": "node scripts/setup-monaco.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:accounts": "node scripts/verify-account-flow.mjs",
    "build:accounts": "node scripts/account-test-server.mjs build",
    "start:accounts": "node scripts/account-test-server.mjs start --hostname localhost --port 3002",
    "config:check": "node scripts/check-config.mjs",
    "format": "prettier --write src runner tests *.ts *.mts *.mjs *.json README.md",
    "db:dev": "convex dev",
    "db:deploy": "convex deploy",
    "runner:start": "node runner/service.mjs",
    "postinstall": "node scripts/setup-monaco.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@clerk/ui": "^1.42.4",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.27.0",
    "@next/env": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "^0.0.67",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
